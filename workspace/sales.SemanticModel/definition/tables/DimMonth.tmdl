	partition DimMonth = calculated
		mode: import
		source =
				
				DISTINCT(
				    UNION(
				        SELECTCOLUMNS(
				            Actuals,
				            "YearMonth", Actuals[Month]
				        ),
				        SELECTCOLUMNS(
				            Budget,
				            "YearMonth", Budget[Month]
				        )
				    )
				)

